# Copy this file to .env and fill in your own values.
# Never commit the real .env file anywhere public.

PORT=4000

# Any long random string (used to sign login tokens). Change this.
JWT_SECRET=replace_with_a_long_random_string

# The ONLY phone number allowed to log in as admin (digits only, no +91, no spaces)
ADMIN_PHONE=9542356372

# Run: npm run hash-password -- "yourSecretPassword"
# then paste the printed hash below.
ADMIN_PASSWORD_HASH=paste_generated_hash_here

# Upload size limits (in MB)
UPLOAD_MAX_IMAGE_MB=10
UPLOAD_MAX_VIDEO_MB=150

# Comma-separated list of domains allowed to read the public gallery API.
# Use your real website domain in production, e.g. https://siribeautyworld.com
ALLOWED_ORIGINS=*
